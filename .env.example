# Contract suite against a real Cumulocity tenant (pnpm test:contract).
# Copy to .env and fill in a dedicated test tenant and user. The scenarios
# create data and delete it again; audit records they write stay.
C8Y_CONTRACT_BASEURL=https://example.cumulocity.com
C8Y_CONTRACT_TENANT=t12345
C8Y_CONTRACT_USER=contract-test-user
C8Y_CONTRACT_PASSWORD=change-me

# Optional: list the endpoints and query parameters no scenario exercises
# (pnpm test:run, tests/contract/contract-suite.ts).
# C8Y_CONTRACT_COVERAGE=1
